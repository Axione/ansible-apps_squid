{{ ansible_managed | comment }}

{% if squid_notes is defined and squid_notes | length > 0 %}
### Base config
{% for item in squid_notes %}
note {{ item.type | default("rule_matched") }} {{ item.name | default(item.acl_src) }} {{ item.acl_src }} {{ item.acl_dst }}
{% endfor %}

{% endif %}

{% if squid_groups is defined and squid_groups | length > 0 %}
### Group config
{% for group in squid_groups %}
{% if group.destinations is defined %}
{% if group.destinations | reject('match', '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$') | list | length > 0 %}
note rule_matched {{ group.name }}         {{ group.name }} dom_{{ group.name }}
{% endif %}
{% if group.destinations | select('match', '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$') | list | length > 0 %}
note rule_matched {{ group.name }}_ips     {{ group.name }} ips_{{ group.name }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}

### Global config
{% if squid_global_domains is defined and squid_global_domains | length > 0 %}
note rule_matched global_domain {{ squid_localnet_name }} global_domains
{% endif %}
{% if squid_global_ips is defined and squid_global_ips | length > 0 %}
note rule_matched global_ip     {{ squid_localnet_name }} global_ips
{% endif %}

### Catch all
note rule_matched no_rule_set
